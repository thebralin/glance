{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glance",
  "version": "0.5.2",
  "identifier": "kz.bolat.glance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glance",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bolat",
    "category": "Productivity",
    "shortDescription": "Просмотрщик DOCX, PPTX, XLSX, PDF, Markdown и JSON",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/filetypes/pdf.ico": "filetypes/pdf.ico",
      "icons/filetypes/word.ico": "filetypes/word.ico",
      "icons/filetypes/powerpoint.ico": "filetypes/powerpoint.ico",
      "icons/filetypes/excel.ico": "filetypes/excel.ico",
      "icons/filetypes/markdown.ico": "filetypes/markdown.ico",
      "icons/filetypes/text.ico": "filetypes/text.ico",
      "icons/filetypes/json.ico": "filetypes/json.ico"
    },
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Glance.PDF", "description": "PDF документ", "role": "Viewer" },
      { "ext": ["docx", "docm", "dotx"], "name": "Glance.Word", "description": "Документ Word", "role": "Viewer" },
      { "ext": ["pptx", "pptm", "ppsx", "potx"], "name": "Glance.PowerPoint", "description": "Презентация PowerPoint", "role": "Viewer" },
      { "ext": ["xlsx", "xlsm", "xltx"], "name": "Glance.Excel", "description": "Таблица Excel", "role": "Viewer" },
      { "ext": ["md", "markdown"], "name": "Glance.Markdown", "description": "Документ Markdown", "role": "Editor" },
      { "ext": ["txt"], "name": "Glance.Text", "description": "Текстовый документ", "role": "Editor" },
      { "ext": ["json"], "name": "Glance.JSON", "description": "Файл JSON", "role": "Editor" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
